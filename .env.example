# Supabase pooler (recommended for serverless/Vercel)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
# Local Postgres alternative
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rich"
# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-64-hex-chars-min-32-bytes"
# NextAuth / Auth.js — for Google OAuth via own Client ID (shows richafrica.vercel.app instead of supabase.co)
# Create at https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: https://richafrica.vercel.app , http://localhost:3000
# Authorized redirect URI: https://richafrica.vercel.app/api/auth/callback/google , http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET="same-as-JWT_SECRET-or-64-hex"
AUTH_URL="https://richafrica.vercel.app"
